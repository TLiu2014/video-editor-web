# -----------------------------------------------------------------
# Marketing app environment template.
#
# Copy this file to `.env.local` (auto-ignored) and adjust as needed.
# Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle at
# build time — never put secrets behind that prefix.
# -----------------------------------------------------------------

# Where the "Open Editor" CTA points.
#   - Local development: http://localhost:5173 (Vite dev server)
#   - Production:        https://editor.yourdomain.com  (replace with
#                        the real editor subdomain when deploying)
NEXT_PUBLIC_EDITOR_URL=http://localhost:5173
