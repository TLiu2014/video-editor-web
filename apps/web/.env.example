# -----------------------------------------------------------------
# Editor app environment template.
#
# Copy to .env.local (auto-ignored) and adjust as needed. Anything
# prefixed VITE_ is inlined into the client bundle at build time —
# never put secrets behind that prefix.
# -----------------------------------------------------------------

# Where the "Home" link in the toolbar points (back to the marketing site,
# which is a separate app). Leave unset to hide the link — e.g. when
# running the editor on its own.
#   - Local dev:   http://localhost:3000 (Next.js marketing dev server)
#   - Production:  https://yourdomain.com  (replace with the real
#                  marketing domain when deploying)
VITE_MARKETING_URL=http://localhost:3000
